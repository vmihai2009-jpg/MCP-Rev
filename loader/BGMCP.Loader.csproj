<Project Sdk="Microsoft.NET.Sdk">

  <!-- The small add-in Revit loads: owns the ribbon, loads the BG MCP core from its newest version folder, and swaps
       it for a newer build on request (mcp_reload, Reload button) without restarting Revit. It rarely changes. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BGMCP.Loader</AssemblyName>
    <RootNamespace>BarrGazetas.RevitMcp.Loader</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
