<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revit-free tests for the survey core (the patch's 62, plus BG MCP's config, wall fit and DWG reading).
       Run with dotnet run, project tests/SurveyCore, Release. Exit code 0 means all passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SurveyCoreTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Survey\**\*.cs" Link="Survey\%(Filename).cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.0" />
  </ItemGroup>
</Project>
