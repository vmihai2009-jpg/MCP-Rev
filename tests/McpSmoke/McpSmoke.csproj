<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the real MCP server outside Revit (the server, settings and provider discovery have no Revit in them)
       and talks to it over HTTP as Claude would. Run: dotnet run -c Release [path to SurveyToRevit.Revit.dll]
       Exit code 0 = every check passed. The assembly name must not start with "BGMCP": the hub skips its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>McpSmoke</AssemblyName>
    <RootNamespace>McpSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\McpServer.cs" Link="Hub\McpServer.cs" />
    <Compile Include="..\..\Settings.cs" Link="Hub\Settings.cs" />
    <Compile Include="..\..\Providers.cs" Link="Hub\Providers.cs" />
    <Compile Include="..\..\Updater.cs" Link="Hub\Updater.cs" />
    <!-- settings carry survey_fidelity's gate -->
    <Compile Include="..\..\Survey\**\*.cs" Link="Survey\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.0" />
  </ItemGroup>

</Project>
